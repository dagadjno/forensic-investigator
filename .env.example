# Copy to .env and fill in the key(s) for the provider(s) you use.
# main.py loads .env automatically; existing environment variables take precedence.

# Anthropic (default provider)
ANTHROPIC_API_KEY=

# OpenAI (provider: openai)
# OPENAI_API_KEY=

# Gemini (provider: gemini) — google-genai reads GEMINI_API_KEY or GOOGLE_API_KEY
# GEMINI_API_KEY=
